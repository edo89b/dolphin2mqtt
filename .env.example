# Maytronics MyDolphin Plus account.
# Must be created via API with a classic password and have the robot shared to
# it from the MyDolphin Plus app — see the README for the full procedure.
MAYTRONICS_EMAIL=you@example.com
MAYTRONICS_PASSWORD=your-password

# Local MQTT broker
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_PREFIX=dolphin

# Polling / credentials refresh (seconds)
SHADOW_POLL_SECS=300
CREDENTIALS_REFRESH_SECS=3000

LOG_LEVEL=INFO

# Static IPs for the macvlan network. Only needed if you keep the `networks:`
# block in docker-compose.yml; remove both if you use default bridge networking.
DOLPHIN_IPV4=10.0.0.10
DOLPHIN_IPV6=fd00::10
